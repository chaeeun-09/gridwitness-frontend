{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/gw-api/:path*", "destination": "https://gridwitness-api.https.gsmsv.site/:path*" },
    { "source": "/((?!assets/|data/|favicon.svg|gw-api/).*)", "destination": "/index.html" }]
}
